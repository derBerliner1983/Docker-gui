# npm 12 (u. a. auf Arch/CachyOS) führt Install-Skripte von Abhängigkeiten
# standardmäßig NICHT mehr aus. Ohne diese Freigaben wird better-sqlite3 nicht
# kompiliert – die native Bindung fehlt dann und das Backend startet gar nicht
# ("Could not locate the bindings file").
# Ältere npm-Versionen (10/11) ignorieren diese Einträge stillschweigend.
allow-scripts[]=better-sqlite3
allow-scripts[]=node-pty
allow-scripts[]=ssh2
allow-scripts[]=cpu-features
allow-scripts[]=esbuild
allow-scripts[]=protobufjs
